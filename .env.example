APP_ENV=development
APP_NAME=BrandGuard AI
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg://brandguard:change_me@localhost:5432/brandguard

JWT_SECRET_KEY=replace-this-before-authentication
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

RABBITMQ_DEFAULT_USER=brandguard
RABBITMQ_DEFAULT_PASS=brandguard_local_dev
RABBITMQ_DEFAULT_VHOST=/

CELERY_BROKER_URL=amqp://brandguard:brandguard_local_dev@localhost:5672//
CELERY_RESULT_BACKEND=

# Optional AI analysis. Disabled by default.
# Set to openai_compatible to enable AI-assisted tone and messaging checks.
AI_PROVIDER=disabled

# Configure these only when enabling an AI provider.
# Never commit a real API key.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=

# Provider request limits.
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=1800
